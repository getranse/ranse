{
  "name": "ranse",
  "version": "0.1.0",
  "description": "Cloudflare-native shared inbox for support teams",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/getranse/ranse.git"
  },
  "homepage": "https://getranse.com",
  "type": "module",
  "main": "src/server/index.ts",
  "bin": {
    "ranse": "./scripts/ranse.ts"
  },
  "scripts": {
    "dev": "concurrently -n worker,ui -c blue,magenta \"wrangler dev\" \"vite\"",
    "dev:worker": "wrangler dev",
    "dev:ui": "vite",
    "build": "vite build",
    "deploy": "bun scripts/deploy.ts",
    "ranse": "bun scripts/ranse.ts",
    "setup": "bun scripts/setup.ts",
    "db:migrate:local": "wrangler d1 migrations apply ranse-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ranse-db --remote",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && wrangler d1 migrations apply ranse-db --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint src scripts",
    "lines": "node scripts/check-file-size.mjs",
    "lines:update": "node scripts/check-file-size.mjs --update",
    "db-actions": "node scripts/check-db-actions.mjs",
    "db-actions:update": "node scripts/check-db-actions.mjs --update",
    "format": "biome format --write src scripts",
    "cf-typegen": "wrangler types",
    "changeset": "changeset",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "agents": "^0.19.0",
    "ai": "^5.0.0",
    "cloudflare": "^5.2.0",
    "cmdk": "^1.1.1",
    "hono": "^4.12.14",
    "openai": "^6.34.0",
    "postal-mime": "^2.7.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sonner": "^2.0.7",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@changesets/cli": "^2.31.1",
    "@cloudflare/workers-types": "^4.20260418.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.0",
    "husky": "^9.1.7",
    "jsonc-parser": "^3.3.1",
    "lint-staged": "^17.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.83.0"
  },
  "engines": {
    "node": ">=20"
  }
}
